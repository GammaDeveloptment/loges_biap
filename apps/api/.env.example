# Copiar a .env (nunca versionar el .env real - Documento 013, seccion 4).

# Cadena de conexion a la base de datos dedicada de Loges-BIAP en el servidor
# compartido de Gammacargo (Documento 004, seccion 3). En desarrollo local
# requiere VPN activa hacia la red de Gammacargo (Documento 007, riesgo
# senalado; Documento 015, seccion 2).
DATABASE_URL="postgresql://usuario:password@host-interno-gammacargo:5432/loges_biap_dev?schema=public"

# Secreto de firma de JWT (Documento 011, seccion 4). Generar uno propio por
# ambiente, nunca reutilizar este valor de ejemplo.
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Origen permitido para CORS (Documento 013, seccion 2): el frontend Next.js.
WEB_ORIGIN="http://localhost:3001"

# Cola de trabajos del Motor de Agentes (Documento 004, seccion 5; Documento
# 009). Gestionado externo (ej. Upstash) o interno en la misma red, segun la
# politica de salida a internet del segmento donde vive el backend.
REDIS_URL="redis://localhost:6379"

PORT=3000

# --- Integraciones (Documento 010, secciones 4.5.1-4.5.2) ---
# Token de aplicacion privada de HubSpot. No usar en desarrollo local salvo
# que se apunte a un portal de pruebas - nunca al portal real de Gammacargo.
HUBSPOT_PRIVATE_APP_TOKEN=""

# Conexion de alcance minimo a la base de datos de aterrizaje de Loges (ERP),
# distinta de DATABASE_URL (Documento 010, seccion 4.5.2). Vacio hasta que el
# equipo de Loges confirme el esquema.
LOGES_LANDING_DATABASE_URL=""

# --- Proveedor de IA (Documento 004, seccion 4; Documento 009) ---
ANTHROPIC_API_KEY=""
